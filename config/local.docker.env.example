# Local Docker PostgreSQL settings for this project.
# Copy to config/local.env when you want scripts to target the Docker database.

SKATING_DB_HOST=127.0.0.1
SKATING_DB_PORT=55432
SKATING_DB_NAME=skating_data
SKATING_DB_USER=skating_app
SKATING_DB_PASSWORD=change_me_strong_password

# Alternative single-value form:
# SKATING_DATABASE_URL=postgresql://skating_app:change_me_strong_password@127.0.0.1:55432/skating_data
